# Root API environment; never put these values into a VITE_ variable.
PORT=3001
HOST=127.0.0.1
# Empty enables TEMPORARY memory storage locally. Production requires Tiger Data.
DATABASE_URL=
# Optional path to Tiger Data's trusted CA PEM. Certificate verification stays enabled.
DATABASE_CA_FILE=
STATIC_DIR=dist

# Offline ElevenLabs narration generation only (never exposed to browser).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_ORACLE=
ELEVENLABS_VOICE_TELEMACHUS=
ELEVENLABS_VOICE_SPARTAN=
ELEVENLABS_VOICE_ACHILLES=
ELEVENLABS_VOICE_KALOS=
ELEVENLABS_VOICE_DRAGON=
