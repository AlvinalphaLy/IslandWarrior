{
  "name": "island-warrior",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "map": "python tools/reconstruct.py && python tools/build_map.py && python tools/verify_map.py",
    "map:build": "python tools/build_map.py && python tools/verify_map.py",
    "map:cave": "python tools/build_cave.py",
    "characters": "python tools/import_characters.py && python tools/greek_skins.py",
    "compare": "python tools/verify_map.py",
    "smoke": "node tools/smoke.mjs",
    "api:dev": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "test:integrations": "node --import tsx --test server/*.test.ts",
    "api:check": "tsc -p server/tsconfig.json",
    "start": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx server/migrate.ts",
    "smoke:integrations": "node --import tsx tools/integrations-smoke.mjs",
    "voices": "node --env-file-if-exists=.env.local --import tsx tools/voices.ts",
    "smoke:narration": "node --import tsx tools/narration-smoke.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"server/**/*.ts\" \"integrations/**/*.{ts,html}\" \"agents/oracle/*.mjs\" \"tools/*.{mjs,ts}\" \"*.html\" \"*.ts\" \"deploy/*.yaml\" package.json tsconfig.json server/tsconfig.json agents/oracle/package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"server/**/*.ts\" \"integrations/**/*.{ts,html}\" \"agents/oracle/*.mjs\" \"tools/*.{mjs,ts}\" \"*.html\" \"*.ts\" \"deploy/*.yaml\" package.json tsconfig.json server/tsconfig.json agents/oracle/package.json .prettierrc.json",
    "smoke:story": "node --import tsx tools/story-smoke.mjs"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "phaser": "3.80.1",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "prettier": "^3.10.1",
    "puppeteer-core": "^23.6.0",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
